"""
Real-time Detection Engine
Handles fire and animal detection using trained YOLO models.

Batch inference
───────────────
UnifiedDetector.detect_batch(frames_dict) accepts a dict of
{camera_id: frame} and runs a single forward pass per model
for all cameras, returning {camera_id: {'fire': [...], 'animal': [...]}}.

This is 3–5× faster on GPU compared to calling detect() per camera.
"""

import cv2
import numpy as np
from ultralytics import YOLO
from typing import List, Dict, Tuple, Optional
import yaml
from pathlib import Path
import time


class Detection:
    """Represents one bounding-box detection."""

    def __init__(self, class_id: int, class_name: str, confidence: float,
                 bbox: Tuple[int, int, int, int], timestamp: float):
        self.class_id   = class_id
        self.class_name = class_name
        self.confidence = confidence
        self.bbox       = bbox       # (x1, y1, x2, y2)
        self.timestamp  = timestamp

    def to_dict(self) -> Dict:
        return {
            'class_id':   self.class_id,
            'class_name': self.class_name,
            'confidence': round(self.confidence, 3),
            'bbox':       self.bbox,
            'timestamp':  self.timestamp,
        }


# ── Base detector ──────────────────────────────────────────────────────────────

class _BaseDetector:
    """Shared YOLO loading + single-frame + batch inference."""

    model_config_key: str = ''    # override in subclass

    def __init__(self, config_path: str = 'config.yaml'):
        with open(config_path, 'r') as f:
            self.config = yaml.safe_load(f)

        cfg = self.config['models'][self.model_config_key]
        self.model_path           = cfg['model_path']
        self.confidence_threshold = cfg['confidence_threshold']
        self.iou_threshold        = cfg['iou_threshold']
        self.classes              = cfg['classes']
        self.model: Optional[YOLO] = None
        self._load_model()

    def _load_model(self) -> bool:
        if not Path(self.model_path).exists():
            print(f'[!] Model not found: {self.model_path}')
            return False
        try:
            self.model = YOLO(self.model_path)
            print(f'[OK] Loaded {self.model_config_key} model from {self.model_path}')
            return True
        except Exception as e:
            print(f'[X] Failed to load {self.model_config_key} model: {e}')
            return False

    def detect(self, frame: np.ndarray) -> List[Detection]:
        """Single-frame inference."""
        if self.model is None:
            return []
        return self._parse_results(
            self.model([frame], conf=self.confidence_threshold,
                       iou=self.iou_threshold, verbose=False)
        )

    def detect_batch(self, frames: List[np.ndarray]) -> List[List[Detection]]:
        """
        Batch inference: one forward pass for all frames.
        Returns a list of detection lists, one per input frame.
        """
        if self.model is None or not frames:
            return [[] for _ in frames]
        try:
            results = self.model(
                frames,
                conf=self.confidence_threshold,
                iou=self.iou_threshold,
                verbose=False,
            )
            return [self._parse_single_result(r) for r in results]
        except Exception as e:
            print(f'[X] Batch inference error ({self.model_config_key}): {e}')
            return [[] for _ in frames]

    def _parse_results(self, results) -> List[Detection]:
        detections = []
        ts = time.time()
        for r in results:
            detections.extend(self._parse_single_result(r, ts))
        return detections

    def _parse_single_result(self, result, ts: float = None) -> List[Detection]:
        if ts is None:
            ts = time.time()
        detections = []
        for box in result.boxes:
            class_id   = int(box.cls[0])
            confidence = float(box.conf[0])
            x1, y1, x2, y2 = map(int, box.xyxy[0])
            if 0 <= class_id < len(self.classes):
                detections.append(Detection(
                    class_id=class_id,
                    class_name=self.classes[class_id],
                    confidence=confidence,
                    bbox=(x1, y1, x2, y2),
                    timestamp=ts,
                ))
        return detections

    def draw_detections(self, frame: np.ndarray, detections: List[Detection],
                        colors: Dict[str, Tuple]) -> np.ndarray:
        annotated = frame.copy()
        default_color = (0, 255, 255)
        for det in detections:
            x1, y1, x2, y2 = det.bbox
            color = colors.get(det.class_name, default_color)
            cv2.rectangle(annotated, (x1, y1), (x2, y2), color, 2)
            label      = f'{det.class_name}: {det.confidence:.2f}'
            label_size = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.6, 2)[0]
            cv2.rectangle(annotated, (x1, y1 - label_size[1] - 10),
                          (x1 + label_size[0], y1), color, -1)
            cv2.putText(annotated, label, (x1, y1 - 5),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)
        return annotated


# ── Specialised detectors ──────────────────────────────────────────────────────

class FireDetector(_BaseDetector):
    model_config_key = 'fire_detection'
    _COLORS = {'fire': (0, 0, 255), 'smoke': (0, 165, 255)}

    def draw_detections(self, frame, detections):
        return super().draw_detections(frame, detections, self._COLORS)


class AnimalDetector(_BaseDetector):
    model_config_key = 'animal_detection'
    _COLORS = {
        'deer':      (0, 255, 0),
        'elephant':  (255, 0, 0),
        'tiger':     (0, 0, 255),
        'bear':      (139, 69, 19),
        'leopard':   (255, 255, 0),
        'wild_boar': (128, 128, 128),
        'monkey':    (255, 165, 0),
        'bison':     (165, 42, 42),
    }

    def draw_detections(self, frame, detections):
        return super().draw_detections(frame, detections, self._COLORS)


# ── UnifiedDetector ────────────────────────────────────────────────────────────

class UnifiedDetector:
    """
    Facade for fire + animal detection.

    Single-frame API (backward-compatible)
    ───────────────────────────────────────
    detections = detector.detect_all(frame)
    # → {'fire': [...], 'animal': [...]}

    Batch API (new — use this for multi-camera loops)
    ──────────────────────────────────────────────────
    camera_ids = ['cam_1', 'cam_2', 'cam_3']
    frames     = {cid: camera_feeds[cid].current_frame for cid in camera_ids}
    results    = detector.detect_batch(frames)
    # → {'cam_1': {'fire': [...], 'animal': [...]}, 'cam_2': {...}, ...}
    """

    def __init__(self, config_path: str = 'config.yaml'):
        self.fire_detector   = FireDetector(config_path)
        self.animal_detector = AnimalDetector(config_path)

    # ── Single-frame (backward-compatible) ────────────────────────────────────

    def detect_all(self, frame: np.ndarray) -> Dict[str, List[Detection]]:
        return {
            'fire':   self.fire_detector.detect(frame),
            'animal': self.animal_detector.detect(frame),
        }

    def draw_all_detections(self, frame: np.ndarray,
                            detections: Dict[str, List[Detection]]) -> np.ndarray:
        annotated = self.fire_detector.draw_detections(frame.copy(), detections['fire'])
        annotated = self.animal_detector.draw_detections(annotated,  detections['animal'])
        return annotated

    # ── Batch multi-camera API ─────────────────────────────────────────────────

    def detect_batch(self, frames: Dict[str, np.ndarray]) \
            -> Dict[str, Dict[str, List[Detection]]]:
        """
        Run one forward pass per model over all camera frames simultaneously.

        Args:
            frames: {camera_id: frame_ndarray}  — only include cameras with
                    a valid (non-None) frame.

        Returns:
            {camera_id: {'fire': [...], 'animal': [...]}}
        """
        if not frames:
            return {}

        camera_ids    = list(frames.keys())
        frame_list    = [frames[cid] for cid in camera_ids]

        fire_results   = self.fire_detector.detect_batch(frame_list)
        animal_results = self.animal_detector.detect_batch(frame_list)

        return {
            cid: {
                'fire':   fire_results[i],
                'animal': animal_results[i],
            }
            for i, cid in enumerate(camera_ids)
        }
