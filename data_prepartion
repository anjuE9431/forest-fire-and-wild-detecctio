        prep = DatasetPreparation(args.source, args.dest)

        if args.verify:
            prep.verify_labels('train')
            prep.verify_labels('val')
            prep.verify_labels('test')
        else:
            # Organize dataset
            prep.organize_dataset()

            # Verify labels
            prep.verify_labels('train')

