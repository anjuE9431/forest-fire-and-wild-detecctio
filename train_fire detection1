import os
import yaml
from ultralytics import YOLO
import torch
from pathlib import Path
import shutil
from datetime import datetime

class FastFireDetectionTrainer:
    def __init__(self, config_path='config.yaml'):
        """Initialize the fire detection trainer"""
        with open(config_path, 'r') as f:
            self.config = yaml.safe_load(f)

        self.fire_config = self.config['training']['fire']
        self.model_config = self.config['models']['fire_detection']

        # Create directories
        self.setup_directories()

    def setup_directories(self):
        """Create necessary directories for training"""
        dirs = [
            'datasets/fire/train/images',
            'datasets/fire/train/labels',
            'datasets/fire/val/images',
            'datasets/fire/val/labels',
            'datasets/fire/test/images',
            'datasets/fire/test/labels',
            'models',
            'runs/fire',
            'logs'
        ]
        for dir_path in dirs:
            Path(dir_path).mkdir(parents=True, exist_ok=True)

    def create_dataset_yaml(self):
        """Create YOLO dataset configuration file"""
        dataset_config = {
            'path': os.path.abspath('datasets/fire'),
            'train': 'train/images',
            'val': 'val/images',
            'test': 'test/images',
            'nc': len(self.model_config['classes']),
            'names': self.model_config['classes']
        }

        yaml_path = 'datasets/fire/data.yaml'
        with open(yaml_path, 'w') as f:
            yaml.dump(dataset_config, f, default_flow_style=False)

        print(f"[OK] Dataset configuration created at {yaml_path}")
        return yaml_path

    def prepare_model(self):
        """Initialize YOLO model for training"""
        # Use nano model for fastest training
        model = YOLO('yolov8n.pt')
        print("[OK] Model initialized with YOLOv8n (fastest)")
        return model

