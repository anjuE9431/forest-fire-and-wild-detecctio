<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin — SENTINEL Database</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,600&family=Outfit:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
    <div class="container">

        <!-- Header -->
        <header class="header glass-panel">
            <div class="logo">
                <div class="logo-icon" style="background:linear-gradient(135deg,rgba(232,98,26,.4),rgba(180,60,10,.5));"><i class="fas fa-database"></i></div>
                <div>
                    <h1>Database Management</h1>
                    <span class="logo-sub">System Administration</span>
                </div>
            </div>
            <div class="header-info">
                <a href="{{ url_for('index') }}" class="logout-btn"><i class="fas fa-arrow-left"></i> Dashboard</a>
                <div class="user-info">
                    <span class="user-badge {{ user.role }}"><i class="fas fa-user-shield"></i> {{ user.username }}</span>
                    <a href="{{ url_for('logout') }}" class="logout-btn" style="color:var(--ember)"><i class="fas fa-sign-out-alt"></i></a>
                </div>
            </div>
        </header>

        <!-- DB Stats Bar -->
        <div class="glass-panel" style="padding:16px 22px;">
            <div style="display:flex;gap:2rem;flex-wrap:wrap;align-items:center;">
                <span style="font-family:var(--font-mono);font-size:.62rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;">Quick Stats:</span>
                <span id="stat-users"   style="font-family:var(--font-mono);font-size:.82rem;color:var(--text-secondary);"><i class="fas fa-users" style="color:var(--biolum);margin-right:6px;"></i>— Users</span>
                <span id="stat-det"     style="font-family:var(--font-mono);font-size:.82rem;color:var(--text-secondary);"><i class="fas fa-crosshairs" style="color:var(--amber);margin-right:6px;"></i>— Detections</span>
                <span id="stat-alerts"  style="font-family:var(--font-mono);font-size:.82rem;color:var(--text-secondary);"><i class="fas fa-bell" style="color:var(--ember);margin-right:6px;"></i>— Alerts</span>
                <span id="stat-cameras" style="font-family:var(--font-mono);font-size:.82rem;color:var(--text-secondary);"><i class="fas fa-video" style="color:var(--leaf);margin-right:6px;"></i>— Cameras</span>
            </div>
        </div>

        <!-- Users Table -->
        <div class="glass-panel" style="padding:22px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <h2 style="font-family:var(--font-mono);font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;display:flex;align-items:center;gap:9px;margin:0;color:var(--text-secondary);">
                    <i class="fas fa-users" style="color:var(--biolum);"></i> Users
                </h2>
                <div class="action-buttons" style="margin:0;">
                    <button class="btn btn-success" onclick="showAddUserModal()"><i class="fas fa-user-plus"></i> Add User</button>
                    <button class="btn btn-primary" onclick="refreshTable('users')"><i class="fas fa-sync"></i> Refresh</button>
                    <button class="btn btn-secondary" onclick="exportTable('users')"><i class="fas fa-download"></i> Export CSV</button>
                </div>
            </div>
            <div class="table-container">
                <table class="data-table" id="users-table">
                    <thead><tr>
                        <th>ID</th><th>Username</th><th>Email</th><th>Role</th>
                        <th>Created At</th><th>Last Login</th><th>Status</th><th>Actions</th>
                    </tr></thead>
                    <tbody id="users-tbody">
                        <tr><td colspan="8" style="text-align:center;color:var(--text-muted);padding:32px;"><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Detections Table -->
        <div class="glass-panel" style="padding:22px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <h2 style="font-family:var(--font-mono);font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;display:flex;align-items:center;gap:9px;margin:0;color:var(--text-secondary);">
                    <i class="fas fa-crosshairs" style="color:var(--amber);"></i> Recent Detections
                </h2>
                <div class="action-buttons" style="margin:0;">
                    <button class="btn btn-primary" onclick="refreshTable('detections')"><i class="fas fa-sync"></i> Refresh</button>
                    <button class="btn btn-secondary" onclick="exportTable('detections')"><i class="fas fa-download"></i> Export CSV</button>
                </div>
            </div>
            <div class="filter-bar">
                <select id="detection-type-filter" onchange="filterDetections()">
                    <option value="">All Types</option>
                    <option value="fire">Fire</option>
                    <option value="animal">Animal</option>
                </select>
                <input type="date" id="detection-date-filter" onchange="filterDetections()">
            </div>
            <div class="table-container">
                <table class="data-table" id="detections-table">
                    <thead><tr>
                        <th>ID</th><th>Timestamp</th><th>Camera</th><th>Type</th>
                        <th>Class</th><th>Confidence</th><th>Location</th>
                    </tr></thead>
                    <tbody id="detections-tbody">
                        <tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:32px;"><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Email Configuration -->
        <div class="glass-panel" style="padding:22px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <h2 style="font-family:var(--font-mono);font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;display:flex;align-items:center;gap:9px;margin:0;color:var(--text-secondary);">
                    <i class="fas fa-envelope" style="color:var(--info);"></i> Email Configuration
                </h2>
                <div class="action-buttons" style="margin:0;">
                    <button class="btn btn-primary" onclick="loadEmailConfig()"><i class="fas fa-sync"></i> Refresh</button>
                    <button class="btn btn-warning" onclick="editEmailConfig()"><i class="fas fa-edit"></i> Edit</button>
                    <button class="btn btn-success" onclick="testEmail()"><i class="fas fa-paper-plane"></i> Test Email</button>
                </div>
            </div>
            <div id="email-config-display" class="json-viewer"><span style="color:var(--text-muted);">Loading config...</span></div>
        </div>

        <!-- Alerts Table -->
        <div class="glass-panel" style="padding:22px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <h2 style="font-family:var(--font-mono);font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;display:flex;align-items:center;gap:9px;margin:0;color:var(--text-secondary);">
                    <i class="fas fa-bell" style="color:var(--ember);"></i> Alert History
                </h2>
                <div class="action-buttons" style="margin:0;">
                    <button class="btn btn-primary" onclick="refreshTable('alerts')"><i class="fas fa-sync"></i> Refresh</button>
                    <button class="btn btn-secondary" onclick="exportTable('alerts')"><i class="fas fa-download"></i> Export CSV</button>
                </div>
            </div>
            <div class="table-container">
                <table class="data-table" id="alerts-table">
                    <thead><tr>
                        <th>ID</th><th>Sent At</th><th>Type</th><th>Severity</th><th>Location</th><th>Status</th>
                    </tr></thead>
                    <tbody id="alerts-tbody">
                        <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:32px;"><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- User Modal -->
    <div class="modal" id="user-modal" role="dialog" aria-modal="true">
        <div class="modal-content glass-panel" style="width:500px;max-width:94vw;">
            <div class="modal-header">
                <h2><i class="fas fa-user-cog"></i> <span id="user-modal-title">Add User</span></h2>
                <button class="modal-close" onclick="closeModal('user-modal')" aria-label="Close">&times;</button>
            </div>
            <div style="padding:20px;">
                <form id="user-form" onsubmit="saveUser(event)">
                    <input type="hidden" id="user-id">
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" id="user-username" placeholder="Enter username" required>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" id="user-email" placeholder="Enter email" required>
                    </div>
                    <div class="form-group">
                        <label>Password <span id="password-hint" style="color:var(--text-muted);font-size:0.7rem;text-transform:none;letter-spacing:0;"></span></label>
                        <input type="password" id="user-password" placeholder="Enter password">
                    </div>
                    <div class="form-group">
                        <label>Role</label>
                        <select id="user-role">
                            <option value="viewer">Viewer</option>
                            <option value="analyst">Analyst</option>
                            <option value="operator">Operator</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label style="flex-direction:row;align-items:center;gap:9px;cursor:pointer;display:flex;text-transform:none;letter-spacing:0;font-size:.82rem;">
                            <input type="checkbox" id="user-active" checked style="width:auto;"> Active Account
                        </label>
                    </div>
                    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:18px;">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('user-modal')">Cancel</button>
                        <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Save User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Email Config Modal -->
    <div class="modal" id="email-config-modal" role="dialog" aria-modal="true">
        <div class="modal-content glass-panel" style="width:600px;max-width:94vw;max-height:90vh;overflow-y:auto;">
            <div class="modal-header">
                <h2><i class="fas fa-envelope-open-text"></i> Email Configuration</h2>
                <button class="modal-close" onclick="closeModal('email-config-modal')" aria-label="Close">&times;</button>
            </div>
            <div style="padding:20px;">
                <form id="email-config-form" onsubmit="saveEmailConfig(event)">
                    <div class="form-group">
                        <label style="flex-direction:row;align-items:center;gap:9px;cursor:pointer;display:flex;text-transform:none;letter-spacing:0;font-size:.82rem;">
                            <input type="checkbox" id="email-enabled" style="width:auto;"> Enable Email Alerts
                        </label>
                    </div>
                    <div class="form-group"><label>SMTP Server</label><input type="text" id="smtp-server" placeholder="smtp.gmail.com"></div>
                    <div class="form-group"><label>SMTP Port</label><input type="number" id="smtp-port" value="587"></div>
                    <div class="form-group">
                        <label style="flex-direction:row;align-items:center;gap:9px;cursor:pointer;display:flex;text-transform:none;letter-spacing:0;font-size:.82rem;">
                            <input type="checkbox" id="use-tls" checked style="width:auto;"> Use TLS Encryption
                        </label>
                    </div>
                    <div class="form-group"><label>Sender Email</label><input type="email" id="sender-email" placeholder="your-email@gmail.com"></div>
                    <div class="form-group"><label>Sender Password</label><input type="password" id="sender-password" placeholder="Leave blank to keep current"></div>
                    <div class="form-group"><label>Sender Name</label><input type="text" id="sender-name" value="Forest Monitoring System"></div>
                    <div class="form-group">
                        <label>Recipients (one per line)</label>
                        <textarea id="recipients" placeholder="email1@example.com&#10;email2@example.com"></textarea>
                    </div>
                    <div class="form-group">
                        <label style="flex-direction:row;align-items:center;gap:9px;cursor:pointer;display:flex;text-transform:none;letter-spacing:0;font-size:.82rem;">
                            <input type="checkbox" id="fire-alert-enabled" checked style="width:auto;"> Enable Fire Alerts
                        </label>
                    </div>
                    <div class="form-group">
                        <label style="flex-direction:row;align-items:center;gap:9px;cursor:pointer;display:flex;text-transform:none;letter-spacing:0;font-size:.82rem;">
                            <input type="checkbox" id="animal-alert-enabled" checked style="width:auto;"> Enable Animal Alerts
                        </label>
                    </div>
                    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:18px;">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('email-config-modal')">Cancel</button>
                        <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Save Config</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
    const Toast = (() => {
        let c = null;
        function gc() { if(!c){c=document.createElement('div');c.className='toast-container';document.body.appendChild(c);} return c; }
        const icons = {success:'fa-check-circle',error:'fa-exclamation-circle',warning:'fa-exclamation-triangle',info:'fa-info-circle',loading:'fa-spinner fa-spin'};
        function show(msg, type='info', dur=4000) {
            const t=document.createElement('div'); t.className=`toast toast-${type}`;
            t.innerHTML=`<i class="fas ${icons[type]||icons.info}"></i><span>${msg}</span><button class="toast-close"><i class="fas fa-times"></i></button>`;
            t.querySelector('.toast-close').addEventListener('click',()=>dismiss(t));
            gc().appendChild(t);
            requestAnimationFrame(()=>requestAnimationFrame(()=>t.classList.add('show')));
            if(dur>0) setTimeout(()=>dismiss(t),dur);
            return t;
        }
        function dismiss(t){if(!t||!t.isConnected)return;t.classList.remove('show');t.classList.add('hide');t.addEventListener('transitionend',()=>t.remove(),{once:true});}
        return {success:m=>show(m,'success'),error:m=>show(m,'error'),warning:m=>show(m,'warning'),loading:m=>show(m,'loading',0),dismiss};
    })();

    function formatDate(iso) {
        if (!iso) return '—';
        return new Date(iso).toLocaleString('en-GB', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
    }
    function badge(text, cls) { return `<span class="badge ${cls}">${text}</span>`; }

    document.addEventListener('DOMContentLoaded', () => {
        loadStats();
        refreshTable('users');
        refreshTable('detections');
        refreshTable('alerts');
        loadEmailConfig();
    });

    async function loadStats() {
        try {
            const r = await fetch('/api/admin/database/stats');
            if (!r.ok) return;
            const d = await r.json();
            document.getElementById('stat-users').innerHTML   = `<i class="fas fa-users" style="color:var(--biolum);margin-right:6px;"></i>${d.users} Users`;
            document.getElementById('stat-det').innerHTML     = `<i class="fas fa-crosshairs" style="color:var(--amber);margin-right:6px;"></i>${d.detections} Detections`;
            document.getElementById('stat-alerts').innerHTML  = `<i class="fas fa-bell" style="color:var(--ember);margin-right:6px;"></i>${d.alerts} Alerts`;
            document.getElementById('stat-cameras').innerHTML = `<i class="fas fa-video" style="color:var(--leaf);margin-right:6px;"></i>${d.cameras} Cameras`;
        } catch(e) {}
    }

    async function refreshTable(name) {
        const tbody = document.getElementById(`${name}-tbody`);
        tbody.innerHTML = `<tr><td colspan="20" style="text-align:center;color:var(--text-muted);padding:32px;"><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>`;
        try {
            if (name === 'users') await loadUsers(tbody);
            else if (name === 'detections') await loadDetections(tbody);
            else if (name === 'alerts') await loadAlerts(tbody);
        } catch(e) {
            tbody.innerHTML = `<tr><td colspan="20" style="text-align:center;color:var(--ember);padding:24px;"><i class="fas fa-exclamation-circle"></i> Failed to load ${name}</td></tr>`;
        }
    }

    async function loadUsers(tbody) {
        const r = await fetch('/api/admin/database/users');
        if (!r.ok) throw new Error('HTTP '+r.status);
        const d = await r.json();
        if (!d.users.length) { tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;color:var(--text-muted);padding:24px;">No users found</td></tr>`; return; }
        tbody.innerHTML = d.users.map(u => `
            <tr>
                <td style="font-family:var(--font-mono);color:var(--text-muted);">#${u.id}</td>
                <td><strong style="color:var(--text);">${u.username}</strong></td>
                <td style="color:var(--text-secondary);">${u.email}</td>
                <td>${badge(u.role, u.role)}</td>
                <td style="font-family:var(--font-mono);font-size:0.75rem;color:var(--text-muted);">${formatDate(u.created_at)}</td>
                <td style="font-family:var(--font-mono);font-size:0.75rem;color:var(--text-muted);">${formatDate(u.last_login)}</td>
                <td>${badge(u.is_active ? 'active':'inactive', u.is_active ? 'active':'inactive')}</td>
                <td>
                    <div style="display:flex;gap:5px;">
                        <button class="btn btn-warning" style="padding:4px 9px;font-size:0.7rem;" onclick="editUser(${u.id})"><i class="fas fa-edit"></i></button>
                        <button class="btn btn-danger"  style="padding:4px 9px;font-size:0.7rem;" onclick="deleteUser(${u.id},'${u.username}')"><i class="fas fa-trash"></i></button>
                    </div>
                </td>
            </tr>`).join('');
    }

    async function loadDetections(tbody) {
        const type = document.getElementById('detection-type-filter')?.value || '';
        const date = document.getElementById('detection-date-filter')?.value || '';
        const params = new URLSearchParams({ limit: 100 });
        if (type) params.append('type', type);
        if (date) params.append('date', date);
        const r = await fetch(`/api/admin/database/detections?${params}`);
        if (!r.ok) throw new Error('HTTP '+r.status);
        const d = await r.json();
        if (!d.detections.length) { tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:24px;">No detections found</td></tr>`; return; }
        tbody.innerHTML = d.detections.map(det => `
            <tr>
                <td style="font-family:var(--font-mono);color:var(--text-muted);">#${det.id}</td>
                <td style="font-family:var(--font-mono);font-size:0.75rem;">${formatDate(det.timestamp)}</td>
                <td style="font-family:var(--font-mono);color:var(--biolum);">${det.camera_id}</td>
                <td>${badge(det.detection_type, det.detection_type)}</td>
                <td><strong style="color:var(--text);">${det.class_name}</strong></td>
                <td style="font-family:var(--font-mono);color:${det.confidence > 0.8 ? 'var(--leaf)' : det.confidence > 0.6 ? 'var(--amber)' : 'var(--text-muted)'};">${(det.confidence * 100).toFixed(1)}%</td>
                <td style="color:var(--text-secondary);">${det.location || '—'}</td>
            </tr>`).join('');
    }

    async function loadAlerts(tbody) {
        const r = await fetch('/api/admin/database/alerts?limit=50');
        if (!r.ok) throw new Error('HTTP '+r.status);
        const d = await r.json();
        if (!d.alerts.length) { tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:24px;">No alerts found</td></tr>`; return; }
        const severityColor = { CRITICAL:'var(--red)', HIGH:'var(--ember)', MEDIUM:'var(--amber)', LOW:'var(--leaf)' };
        tbody.innerHTML = d.alerts.map(a => `
            <tr>
                <td style="font-family:var(--font-mono);color:var(--text-muted);">#${a.id}</td>
                <td style="font-family:var(--font-mono);font-size:0.75rem;">${formatDate(a.sent_at)}</td>
                <td>${badge(a.alert_type, a.alert_type)}</td>
                <td style="color:${severityColor[a.severity]||'var(--text-secondary)'};font-family:var(--font-mono);font-size:0.75rem;font-weight:600;">${a.severity}</td>
                <td style="color:var(--text-secondary);">${a.location || '—'}</td>
                <td>${badge(a.status || 'sent', a.status === 'failed' ? 'failed' : 'sent')}</td>
            </tr>`).join('');
    }

    function filterDetections() { refreshTable('detections'); }

    async function exportTable(name) {
        const loading = Toast.loading(`Exporting ${name}...`);
        try {
            const link = document.createElement('a');
            link.href = `/api/admin/export/${name}`;
            link.download = `${name}_export.csv`;
            link.click();
            Toast.dismiss(loading); Toast.success(`${name} exported!`);
        } catch(e) { Toast.dismiss(loading); Toast.error('Export failed'); }
    }

    function showAddUserModal() {
        document.getElementById('user-modal-title').textContent = 'Add User';
        document.getElementById('user-form').reset();
        document.getElementById('user-id').value = '';
        document.getElementById('password-hint').textContent = '(required)';
        document.getElementById('user-password').required = true;
        document.getElementById('user-modal').style.display = 'flex';
    }

    async function editUser(userId) {
        try {
            const r = await fetch('/api/admin/database/users');
            const d = await r.json();
            const user = d.users.find(u => u.id === userId);
            if (!user) return Toast.error('User not found');
            document.getElementById('user-modal-title').textContent = 'Edit User';
            document.getElementById('user-id').value = user.id;
            document.getElementById('user-username').value = user.username;
            document.getElementById('user-username').disabled = true;
            document.getElementById('user-email').value = user.email;
            document.getElementById('user-password').value = '';
            document.getElementById('user-password').required = false;
            document.getElementById('password-hint').textContent = '(leave blank to keep)';
            document.getElementById('user-role').value = user.role;
            document.getElementById('user-active').checked = user.is_active;
            document.getElementById('user-modal').style.display = 'flex';
        } catch(e) { Toast.error('Failed to load user'); }
    }

    async function saveUser(e) {
        e.preventDefault();
        const id = document.getElementById('user-id').value;
        const isEdit = !!id;
        const payload = { username: document.getElementById('user-username').value, email: document.getElementById('user-email').value, password: document.getElementById('user-password').value, role: document.getElementById('user-role').value, is_active: document.getElementById('user-active').checked };
        const loading = Toast.loading(isEdit ? 'Saving user...' : 'Creating user...');
        try {
            const url = isEdit ? `/api/admin/users/${id}` : '/api/admin/users/create';
            const method = isEdit ? 'PUT' : 'POST';
            const r = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
            const d = await r.json();
            Toast.dismiss(loading);
            if (d.success) { Toast.success(isEdit ? 'User updated!' : 'User created!'); closeModal('user-modal'); document.getElementById('user-username').disabled = false; refreshTable('users'); loadStats(); }
            else Toast.error(d.error || 'Failed to save user');
        } catch(e) { Toast.dismiss(loading); Toast.error('Network error'); }
    }

    async function deleteUser(userId, username) {
        if (!confirm(`Delete user "${username}"? This cannot be undone.`)) return;
        const loading = Toast.loading('Deleting...');
        try {
            const r = await fetch(`/api/admin/users/${userId}`, { method: 'DELETE' });
            const d = await r.json();
            Toast.dismiss(loading);
            if (d.success) { Toast.success('User deleted'); refreshTable('users'); loadStats(); }
            else Toast.error(d.error || 'Failed to delete user');
        } catch(e) { Toast.dismiss(loading); Toast.error('Network error'); }
    }

    async function loadEmailConfig() {
        const el = document.getElementById('email-config-display');
        try {
            const r = await fetch('/api/admin/email-config');
            if (!r.ok) throw new Error('HTTP '+r.status);
            const d = await r.json();
            el.innerHTML = `<pre style="white-space:pre-wrap;">${JSON.stringify(d, null, 2)}</pre>`;
            window._emailConfig = d;
        } catch(e) { el.innerHTML = `<span style="color:var(--ember);">Failed to load config</span>`; }
    }

    function editEmailConfig() {
        const cfg = window._emailConfig || {};
        document.getElementById('email-enabled').checked = cfg.enabled || false;
        document.getElementById('smtp-server').value = cfg.smtp_server || '';
        document.getElementById('smtp-port').value = cfg.smtp_port || 587;
        document.getElementById('use-tls').checked = cfg.use_tls !== false;
        document.getElementById('sender-email').value = cfg.sender_email || '';
        document.getElementById('sender-name').value = cfg.sender_name || '';
        document.getElementById('recipients').value = (cfg.recipients || []).join('\n');
        document.getElementById('fire-alert-enabled').checked = cfg.fire_alert_enabled !== false;
        document.getElementById('animal-alert-enabled').checked = cfg.animal_alert_enabled !== false;
        document.getElementById('email-config-modal').style.display = 'flex';
    }

    async function saveEmailConfig(e) {
        e.preventDefault();
        const payload = { enabled: document.getElementById('email-enabled').checked, smtp_server: document.getElementById('smtp-server').value, smtp_port: parseInt(document.getElementById('smtp-port').value), use_tls: document.getElementById('use-tls').checked, sender_email: document.getElementById('sender-email').value, sender_password: document.getElementById('sender-password').value, sender_name: document.getElementById('sender-name').value, recipients: document.getElementById('recipients').value.split('\n').map(s=>s.trim()).filter(Boolean), fire_alert_enabled: document.getElementById('fire-alert-enabled').checked, animal_alert_enabled: document.getElementById('animal-alert-enabled').checked };
        const loading = Toast.loading('Saving config...');
        try {
            const r = await fetch('/api/admin/email-config', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
            const d = await r.json();
            Toast.dismiss(loading);
            if (d.success) { Toast.success('Email config saved!'); closeModal('email-config-modal'); loadEmailConfig(); }
            else Toast.error(d.error || 'Failed to save config');
        } catch(e) { Toast.dismiss(loading); Toast.error('Network error'); }
    }

    async function testEmail() {
        const loading = Toast.loading('Sending test email...');
        try {
            const r = await fetch('/api/admin/test-email', { method: 'POST' });
            const d = await r.json();
            Toast.dismiss(loading);
            if (d.success) Toast.success('Test email sent!');
            else Toast.error(d.error || 'Failed to send test email');
        } catch(e) { Toast.dismiss(loading); Toast.error('Network error'); }
    }

    function closeModal(id) {
        document.getElementById(id).style.display = 'none';
        if (id === 'user-modal') document.getElementById('user-username').disabled = false;
    }

    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', e => { if (e.target === modal) modal.style.display = 'none'; });
    });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') document.querySelectorAll('.modal').forEach(m => { m.style.display = 'none'; });
    });
    </script>
</body>
</html>
